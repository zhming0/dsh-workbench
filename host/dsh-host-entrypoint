#!/bin/sh
# Boot the web profile. Extra container arguments are passed to the web app,
# so a manifest can add flags such as --trusted-host.
set -eu

dsh-host-seed

set -- --port "${DSH_WEB_PORT:-3000}" --no-open "$@"
# DSH_HOST_LAUNCH_TOKEN_ROUTE=1 mounts GET /launch-token (see
# launch-token.patch.yml). The overlay is a launcher flag, so it goes before
# the web app's arguments.
if [ "${DSH_HOST_LAUNCH_TOKEN_ROUTE:-0}" = 1 ]; then
  set -- --patch /opt/dsh-host/launch-token.patch.yml "$@"
fi
exec dsh --profile web "$@"
