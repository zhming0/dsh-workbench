#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Same bootstrap CI uses, so an agent and a build get identical tool versions.
source "${ROOT_DIR}/.buildkite/steps/lib/mise.bash"
ensure_tools

# Later shells in this sandbox get ~/.local/bin on PATH but not the mise shims
# directory, so link the shims across.
mkdir -p "$HOME/.local/bin"
ln -sf "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims/"* "$HOME/.local/bin/"

pnpm install --frozen-lockfile
