#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools

VERSION="$(buildkite-agent meta-data get release-version)"
TAG="$VERSION"
HOST_IMAGE="ghcr.io/zhming0/dsh-host"
RUNNER_IMAGE="ghcr.io/zhming0/dsh-runner"

echo "--- :git: Configuring HTTPS authentication"
# The push remote is HTTPS, and Buildkite's hosted git credentials do not
# cover this repository, so the push carries the ambient token in its URL.
git config url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

echo "--- :git: Tagging $TAG"
git tag "$TAG"
git push origin "$TAG"

echo "+++ :github: Creating GitHub release"
gh release create "$TAG" --title "$TAG" --generate-notes --notes "## Images

\`\`\`
docker pull ${HOST_IMAGE}:${VERSION}
docker pull ${RUNNER_IMAGE}:${VERSION}
\`\`\`

Both built for \`linux/amd64\` and \`linux/arm64\`. The host image is the dsh
distribution: dsh with the web profile and this provider assembled at the same
version. The provider inside it defaults to the runner image tag above, so the
pair always ships together.
"
